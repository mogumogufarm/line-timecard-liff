# LINE 打刻システム - 環境変数設定サンプル
# 本番環境では .env にコピーして実際の値を入力してください
# DO NOT COMMIT .env to git - add to .gitignore

# Database Configuration
DB_HOST=localhost
DB_USER=mogucorp_db
DB_PASS=your_secure_password_here
DB_NAME=mogucorp_timecard

# LINE Configuration
# LINE Developers Console から取得
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=your_channel_secret_here
LIFF_ID=1234567890-abcdef

# Application Configuration
APP_URL=https://mogucorp.com/line-timecard-liff/
TIMEZONE=Asia/Tokyo
